{
  "manifest_version": 3,
  "name": "karita に送る",
  "version": "0.6.0",
  "description": "現在のタブ、または図書館タブを開いた元のカーリル書籍 URL を karita へ送る。図書館サイトでは貸出し・マイページ登録の用途も選べる。Amazon のページと karita の連携確認ページは押したら送る。",
  "permissions": ["activeTab"],
  "optional_host_permissions": ["https://calil.jp/*"],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "karita に送る",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "karita-send@getperf.net",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  }
}
